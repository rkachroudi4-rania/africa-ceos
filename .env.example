# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/africa_ceos?schema=public"

# Auth.js / NextAuth secret (generate with: openssl rand -base64 32)
AUTH_SECRET="replace-with-a-long-random-secret"
AUTH_URL="http://localhost:3000"

# Optional: used by the seed script
SEED_ADMIN_EMAIL="admin@africaceos.com"
SEED_ADMIN_PASSWORD="ChangeMeAdmin123!"

# Optional: send password-reset emails with Resend
# If omitted, reset links are returned in the API response in development only
RESEND_API_KEY=""
EMAIL_FROM="Africa CEOs <noreply@africaceos.com>"
